{
    "name": "clauded-git",
    "version": "0.0.1",
    "private": true,
    "description": "Clauded GIT — issues, worktrees, PR et chats Claude Code dans une seule interface locale.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite --config web/vite.config.ts\"",
        "start": "tsx server/index.ts",
        "build": "vite build --config web/vite.config.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
        "spike:check": "tsx spike/check.ts",
        "spike:web": "tsx spike/server.ts"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.322",
        "@fastify/static": "^10.1.10",
        "@fastify/websocket": "^11.3.7",
        "fastify": "^5.12.8",
        "mermaid": "^12.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "ws": "^8.22.2",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.7"
    }
}
